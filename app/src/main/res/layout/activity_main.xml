<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Murmur"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Hint"
            android:text="Speak naturally. Clean text lands in any app." />

        <TextView style="@style/Section" android:text="SETUP" />
        <TextView android:id="@+id/step_mic" style="@style/Step" />
        <TextView android:id="@+id/step_enable" style="@style/Step" />
        <TextView android:id="@+id/step_pick" style="@style/Step" />

        <TextView android:id="@+id/step_one_tap" style="@style/Step" />
        <TextView
            style="@style/Hint"
            android:layout_marginTop="6dp"
            android:text="@string/one_tap_hint" />

        <TextView style="@style/Label" android:text="API key" />
        <EditText
            android:id="@+id/api_key"
            style="@style/Field"
            android:hint="gsk_…"
            android:inputType="textPassword"
            android:importantForAutofill="no" />
        <TextView
            android:id="@+id/get_key"
            style="@style/Hint"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Tap here to get a free Groq key (console.groq.com/keys)"
            android:textColor="@color/accent" />

        <TextView style="@style/Section" android:text="TRY IT" />
        <EditText
            android:id="@+id/try_it"
            style="@style/Field"
            android:gravity="top"
            android:hint="Tap here, switch to the Murmur keyboard, and talk"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3" />

        <TextView style="@style/Section" android:text="SMART CLEANUP" />
        <Switch
            android:id="@+id/cleanup"
            style="@style/Label"
            android:text="Smart cleanup: remove ums and filler, fix grammar and punctuation, apply self-corrections" />

        <TextView style="@style/Label" android:text="Tone" />
        <TextView
            style="@style/Hint"
            android:text="Also on the keyboard: tap the tone chip to pick, hold it to flip between Professional and Casual. Auto fits the app you're typing in." />
        <Spinner
            android:id="@+id/tone"
            style="@style/Field"
            android:popupBackground="@color/surface" />

        <TextView style="@style/Label" android:text="Your style instructions (optional)" />
        <EditText
            android:id="@+id/style"
            style="@style/Field"
            android:gravity="top"
            android:hint="e.g. No exclamation marks. Sign off with -M."
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2" />

        <Switch
            android:id="@+id/commands"
            style="@style/Label"
            android:text="Voice commands" />
        <TextView
            style="@style/Hint"
            android:text="Right after dictating, tap the mic and say &quot;make that shorter&quot;, &quot;translate that to Spanish&quot;, &quot;make it more professional&quot;, &quot;add some emojis&quot; or &quot;scratch that&quot;. Start with &quot;Murmur,&quot; to ask for anything else. Select text first to edit that instead. ↶ brings back the original." />

        <TextView style="@style/Section" android:text="TYPING" />
        <Switch
            android:id="@+id/autocorrect"
            style="@style/Label"
            android:text="Autocorrect and word suggestions" />
        <TextView
            style="@style/Hint"
            android:text="Fixes typos when you hit space. Backspace right after a fix puts back what you typed, and Murmur stops changing that word. Your vocabulary words are never corrected." />
        <Switch
            android:id="@+id/swipe"
            style="@style/Label"
            android:text="Swipe typing" />
        <TextView
            style="@style/Hint"
            android:text="Slide your finger across the letters to spell a word. Other guesses show above the keys; tap one to swap it in." />
        <Switch
            android:id="@+id/key_vibrate"
            style="@style/Label"
            android:text="Vibrate on each key" />
        <Switch
            android:id="@+id/key_sound"
            style="@style/Label"
            android:text="Click sound on each key" />

        <TextView style="@style/Section" android:text="YOUR VOCABULARY" />
        <TextView style="@style/Label" android:text="Names and words to get right" />
        <TextView
            style="@style/Hint"
            android:text="Tip: select a word in any app while the Murmur keyboard is open, then tap the message above the keys to add it here." />
        <EditText
            android:id="@+id/vocab"
            style="@style/Field"
            android:gravity="top"
            android:hint="Comma-separated: product names, people, slang, work terms"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <Switch
            android:id="@+id/learn"
            style="@style/Label"
            android:text="Learn from my fixes (when I correct a word Murmur typed, remember it)" />
        <TextView style="@style/Label" android:text="What Murmur learned (edit or delete lines)" />
        <EditText
            android:id="@+id/learned"
            style="@style/Field"
            android:gravity="top"
            android:hint="Nothing yet. Fix a name Murmur gets wrong and it shows up here, like: zelvary → Zelvari"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="2" />

        <Switch
            android:id="@+id/learn_style"
            style="@style/Label"
            android:text="Learn how I write, so cleanup sounds like me" />
        <TextView android:id="@+id/samples_info" style="@style/Hint" />
        <TextView
            android:id="@+id/clear_learned"
            style="@style/Step"
            android:gravity="center"
            android:text="Clear what Murmur learned" />
        <TextView
            style="@style/Hint"
            android:text="All of this stays on your phone. It is sent to your AI provider only with each dictation, to spell and phrase it like you." />

        <TextView style="@style/Label" android:text="Language code" />
        <TextView style="@style/Hint" android:text="Blank uses your phone's language, which is the most accurate. Type auto to let it guess, or a code like es." />
        <EditText
            android:id="@+id/language"
            style="@style/Field"
            android:hint="en"
            android:inputType="text"
            android:maxLength="5" />

        <TextView style="@style/Section" android:text="BEHAVIOR" />
        <Switch
            android:id="@+id/auto_start"
            style="@style/Label"
            android:text="Start listening as soon as the keyboard opens" />
        <Switch
            android:id="@+id/auto_return"
            style="@style/Label"
            android:text="Switch back to my regular keyboard after inserting" />

        <TextView style="@style/Section" android:text="ADVANCED" />
        <TextView style="@style/Hint" android:text="Works with any OpenAI-compatible API. Defaults are set for Groq." />
        <TextView style="@style/Label" android:text="API base URL" />
        <EditText android:id="@+id/base_url" style="@style/Field" android:inputType="textUri" />
        <TextView style="@style/Label" android:text="Speech-to-text model" />
        <EditText android:id="@+id/stt_model" style="@style/Field" android:inputType="text" />
        <TextView style="@style/Label" android:text="Cleanup model" />
        <EditText android:id="@+id/llm_model" style="@style/Field" android:inputType="text" />

        <TextView
            android:id="@+id/save"
            style="@style/Step"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Save"
            android:textStyle="bold" />
        <TextView
            style="@style/Hint"
            android:layout_marginBottom="24dp"
            android:text="Word list built from hermitdave/FrequencyWords (OpenSubtitles 2018), CC BY-SA 4.0." />
    </LinearLayout>
</ScrollView>
