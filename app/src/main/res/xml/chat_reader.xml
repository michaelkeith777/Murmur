<?xml version="1.0" encoding="utf-8"?>
<!-- Texting mode: reads only the message bubbles of the open chat, in these chat apps only. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="200"
    android:packageNames="com.whatsapp,com.whatsapp.w4b,com.google.android.apps.messaging,com.samsung.android.messaging,org.telegram.messenger"
    android:description="@string/chat_reader_description"
    android:settingsActivity="com.zelvari.murmur.MainActivity" />
