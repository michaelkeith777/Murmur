<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="4dp"
    android:paddingBottom="6dp">

    <!-- Top bar: the tone chip and status line, or the tone picker in their place. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp">

        <LinearLayout
            android:id="@+id/status_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tone"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="3dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:contentDescription="Writing tone. Tap to change, hold to flip Professional and Casual" />

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/dim"
                android:textSize="13sp" />

            <!-- Word suggestions while typing; takes the status line's place. -->
            <LinearLayout
                android:id="@+id/suggestions"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/translate"
                android:layout_width="42dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:gravity="center"
                android:text="文A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:contentDescription="Speak to translate. Tap to turn on or off, hold to pick the language" />
            <TextView
                android:id="@+id/rewrite"
                android:layout_width="42dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:gravity="center"
                android:text="✍️"
                android:textSize="17sp"
                android:contentDescription="Rewrite the selected text, or the whole message, in a tone" />

            <TextView
                android:id="@+id/tools"
                android:layout_width="42dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="3dp"
                android:gravity="center"
                android:text="📋"
                android:textSize="17sp"
                android:contentDescription="Clipboard, shortcuts and themes" />

            <TextView
                android:id="@+id/cancel"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="3dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:gravity="center"
                android:background="@drawable/bg_key"
                android:text="Cancel"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/tone_picker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/tone_list"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </FrameLayout>

    <!-- Typing keys on the left, the big dictation button on the right. -->
    <LinearLayout
        android:id="@+id/key_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- The keys, or the clipboard / shortcuts / look panel in their place. -->
        <FrameLayout
            android:id="@+id/key_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <com.zelvari.murmur.KeyboardView
                android:id="@+id/keys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <ScrollView
                android:id="@+id/panel_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/panel_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </FrameLayout>

        <!-- On narrow screens (a foldable's cover screen) these two move up into the top bar. -->
        <LinearLayout
            android:id="@+id/mic_col"
            android:layout_width="74dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/k_undo"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_margin="3dp"
                android:gravity="center"
                android:background="@drawable/bg_key"
                android:text="↶"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:contentDescription="Undo last dictation or typed word" />

            <ImageView
                android:id="@+id/mic"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/bg_mic_idle"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic"
                android:contentDescription="Start or stop dictation" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
