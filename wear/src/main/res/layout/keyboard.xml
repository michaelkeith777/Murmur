<?xml version="1.0" encoding="utf-8"?>
<!-- Round-watch keyboard. The inner panel is stretched to the full screen height in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="150dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="start"
            android:gravity="center"
            android:maxLines="3"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="78dp">

            <ImageView
                android:id="@+id/mic"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_idle"
                android:contentDescription="Start or stop dictation"
                android:padding="19dp"
                android:src="@drawable/ic_mic" />

            <TextView
                android:id="@+id/cancel"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="26dp"
                android:background="@drawable/bg_key"
                android:contentDescription="Cancel"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="144dp"
            android:layout_height="42dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/k_undo" style="@style/Key" android:text="↶" android:contentDescription="Undo last dictation" />
            <TextView android:id="@+id/k_del" style="@style/Key" android:text="⌫" android:contentDescription="Backspace" />
            <TextView android:id="@+id/k_enter" style="@style/Key" android:text="✓" android:contentDescription="Send" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
